# ── REQUIRED ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/darkdinu?retryWrites=true&w=majority

# ── OPTIONAL ──
PORT=8000
# Public URL of your app (Render sets RENDER_EXTERNAL_URL automatically). Used for self keep-alive ping.
APP_URL=
# Extra owner numbers (comma separated, with country code)
SUDO=
# public | private | group | inbox  (default work type for new sessions)
WORK_TYPE=public
MAX_SESSIONS=200
TIMEZONE=Asia/Colombo
